{
  "description": "Hypothesis: losing one of three MSK brokers (RF 3) does not touch the payment path; events keep flowing through the S3 sink and consumer lag recovers within 10 min. Stop: chaos-stop alarm. An SSM Automation document reboots the broker.",
  "actions": {
    "reboot-broker": {
      "actionId": "aws:ssm:send-automation-document",
      "description": "Reboot one broker of the stage MSK cluster",
      "parameters": {
        "documentArn": "arn:aws:ssm:${REGION}:${STAGE_ACCOUNT_ID}:document/${NAME_PREFIX}-stage-chaos-msk-reboot-broker",
        "documentParameters": "{\"ClusterName\":\"${NAME_PREFIX}-stage-${REGION_SHORT}-msk\",\"BrokerId\":\"1\"}",
        "maxDuration": "PT15M"
      }
    }
  },
  "stopConditions": [
    { "source": "aws:cloudwatch:alarm", "value": "arn:aws:cloudwatch:${REGION}:${STAGE_ACCOUNT_ID}:alarm:${NAME_PREFIX}-stage-${REGION_SHORT}-chaos-stop" }
  ],
  "roleArn": "arn:aws:iam::${STAGE_ACCOUNT_ID}:role/${NAME_PREFIX}-stage-${REGION_SHORT}-fis-experiment",
  "tags": { "Name": "chaos-msk-broker-loss", "environment": "stage", "failure-mode": "messaging-msk-broker-down" },
  "experimentOptions": { "accountTargeting": "single-account", "emptyTargetResolutionMode": "fail" }
}
