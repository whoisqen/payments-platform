{
  "description": "Hypothesis: with one AZ unreachable the stage cell keeps the SLOs on two AZs (confirm 5xx below 0.01%, overhead p99 below 150 ms) and RTO is 1 min. Stop: chaos-stop alarm (burn rate 14.4 or authorization rate drop above 2 pp).",
  "targets": {
    "az-subnets": {
      "resourceType": "aws:ec2:subnet",
      "resourceTags": { "environment": "stage", "cell": "cell-1", "az": "euc1-az1" },
      "selectionMode": "ALL"
    }
  },
  "actions": {
    "disrupt-az": {
      "actionId": "aws:network:disrupt-connectivity",
      "description": "Block all traffic of the app and data subnets of one AZ",
      "parameters": { "scope": "all", "duration": "PT10M" },
      "targets": { "Subnets": "az-subnets" }
    }
  },
  "stopConditions": [
    { "source": "aws:cloudwatch:alarm", "value": "arn:aws:cloudwatch:eu-central-1:${STAGE_ACCOUNT_ID}:alarm:pay-stage-euc1-chaos-stop" }
  ],
  "roleArn": "arn:aws:iam::${STAGE_ACCOUNT_ID}:role/pay-stage-euc1-fis-experiment",
  "tags": { "Name": "chaos-az-loss", "environment": "stage", "failure-mode": "compute-az-loss" },
  "logConfiguration": {
    "logSchemaVersion": 2,
    "cloudWatchLogsConfiguration": { "logGroupArn": "arn:aws:logs:eu-central-1:${STAGE_ACCOUNT_ID}:log-group:/fis/pay-stage-euc1:*" }
  },
  "experimentOptions": { "accountTargeting": "single-account", "emptyTargetResolutionMode": "fail" }
}
