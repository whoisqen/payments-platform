        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "title": "edge: limited requests, top 5 merchants, reqps",
      "description": "Over-limit descriptors of the rate limit service; merchant_id is a recorded aggregate, never a raw label.",
