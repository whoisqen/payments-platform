        "showThresholdMarkers": true
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Burn rate",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "title": "slo: burn rate over 1 h, x budget",
      "description": "14.4 pages (2% of the budget per hour); 6 pages over 6 hours.",
      "targets": [
        {
          "refId": "A",
          "expr": "slo:sli_error:ratio_rate1h{env=~\"$env\"} / on(env, region, sloth_id, sloth_slo, sloth_service) slo:error_budget:ratio",
          "legendFormat": "{{sloth_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "datasource": {
