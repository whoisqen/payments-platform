{
  "uid": "scheduler",
  "title": "L1 Scheduler (sync and webhooks)",
  "description": "Sync of unknown-state payments and outgoing webhooks.",
  "tags": [
    "payments-platform",
    "l1",
    "scheduler",
    "sync"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "liveNow": false,
  "weekStart": "",
  "fiscalYearStartMonth": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "text": "default",
          "value": "default"
        }
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up, env)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "hide": 0
      },
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{env=~\"$env\"}, region)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "eu-central-1",
          "value": "eu-central-1"
        },
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "cell",
        "label": "Cell",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{env=~\"$env\",region=~\"$region\"}, cell)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{env=~\"$env\"}, service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "scheduler",
          "value": "scheduler"
        },
        "hide": 2,
        "allValue": ".*"
      },
      {
        "name": "psp",
        "label": "PSP",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(psp_requests_total{env=~\"$env\",region=~\"$region\"}, psp)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 2,
        "allValue": ".*"
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "L0 Platform overview",
      "url": "/d/platform-overview",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "type": "link",
      "title": "L1 Payments and PSP health",
      "url": "/d/payments",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "type": "link",
      "title": "L2 Cells",
      "url": "/d/cells",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "type": "dashboards",
      "title": "All dashboards",
      "tags": [
        "payments-platform"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Runbooks: application",
      "url": "https://github.com/whoisqen/payments-platform/tree/main/docs/runbooks/application",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "increase(argocd_app_sync_total{env=~\"$env\",phase=\"Succeeded\"}[2m]) > 0",
        "titleFormat": "deploy {{name}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "title": "scheduler: oldest task age",
      "description": "SchedulerQueueDelayHigh pages above 10 minutes.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(scheduler_queue_oldest_task_age_seconds{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300.0
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "min": 0,
          "decimals": 2,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "title": "scheduler: stale unknown-state",
      "description": "Payments in an unknown state for more than 15 minutes; the scheduler syncs them with the PSP.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(payments_unknown_state_stale{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "min": 0,
          "decimals": 0,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "title": "scheduler: dead-letter queue depth",
      "description": "Tasks that exhausted their retries; any entry needs a look.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dlq_depth{env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "min": 0,
          "decimals": 0,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "title": "scheduler: oldest webhook age",
      "description": "The delivery SLO is 60 s; WebhookBacklogOld warns above 5 minutes.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(webhook_queue_oldest_age_seconds{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              }
            ]
          },
          "min": 0,
          "decimals": 2,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Queues",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "title": "scheduler: oldest task age by cell, s",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cell) (scheduler_queue_oldest_task_age_seconds{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"})",
          "legendFormat": "{{cell}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300.0
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "title": "scheduler: tasks processed per second by kind",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(scheduler_tasks_processed_total{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Webhooks",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "title": "scheduler: webhook delivery p99 by cell, s",
      "description": "The SLO is delivery within 60 s for 99.9% of events.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (cell, le) (rate(webhook_delivery_seconds_bucket{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "{{cell}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "title": "scheduler: dead-letter queue depth by queue",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (queue) (dlq_depth{env=~\"$env\",region=~\"$region\"}))",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Retries",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 9
      },
      "title": "retries: share of the traffic by dependency, %",
      "description": "Retry budget is 10% of the normal traffic to a dependency; above it RetryStorm fires.",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (dependency) (rate(retry_total{env=~\"$env\",region=~\"$region\",service=~\"$service\"}[$__rate_interval])) / (sum by (dependency) (rate(dependency_requests_total{env=~\"$env\",region=~\"$region\",service=~\"$service\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{dependency}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10.0
              }
            ]
          },
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
