        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_server_request_duration_seconds_bucket{env=~\"$env\",region=~\"$region\",cell=~\"$cell\",service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "exemplar": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(http_server_request_duration_seconds_bucket{env=~\"$env\",region=~\"$region\",cell=~\"$cell\",service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "exemplar": true
