    },
    {
      "id": 10,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 9
      },
      "title": "locker: 5xx share by cell, %",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (cell) (rate(http_server_requests_total{env=~\"$env\",region=~\"$region\",cell=~\"$cell\",service=~\"$service\",code=~\"5..\"}[$__rate_interval])) / (sum by (cell) (rate(http_server_requests_total{env=~\"$env\",region=~\"$region\",cell=~\"$cell\",service=~\"$service\"}[$__rate_interval])) > 0)",
