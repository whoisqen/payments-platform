      "title": "locker: CPU use, % of limit",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (pod) (rate(container_cpu_usage_seconds_total{env=~\"$env\",region=~\"$region\",pod=~\"$service.*\"}[5m])) / sum by (pod) (kube_pod_container_resource_limits{env=~\"$env\",region=~\"$region\",pod=~\"$service.*\",resource=\"cpu\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
