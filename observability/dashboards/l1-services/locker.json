        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      },
      "title": "locker: 5xx share by cell, %",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (cell) (rate(http_server_requests_total{env=~\"$env\",region=~\"$region\",cell=~\"$cell\",service=~\"$service\",code=~\"5..\"}[5m])) / sum by (cell) (rate(http_server_requests_total{env=~\"$env\",region=~\"$region\",cell=~\"$cell\",service=~\"$service\"}[5m]))",
          "legendFormat": "{{cell}}"
