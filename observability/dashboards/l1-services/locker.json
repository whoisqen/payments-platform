    },
    {
      "id": 15,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 9
      },
      "title": "locker: CPU use, % of limit (top 8 pods)",
      "description": "",
      "targets": [
