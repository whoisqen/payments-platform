    {
      "id": 12,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "title": "locker: p50, p95, p99 latency, s",
      "description": "Exemplars link a latency peak to a trace in Tempo.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (service, le) (rate(http_server_request_duration_seconds_bucket{env=~\"$env\",region=~\"$region\",cell=~\"$cell\",service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50",
