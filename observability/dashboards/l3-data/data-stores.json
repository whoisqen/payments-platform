          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "title": "opensearch: cluster red status",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (domain_name) (aws_es_cluster_statusred_maximum{env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "{{domain_name}}"
