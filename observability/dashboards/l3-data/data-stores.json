      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "title": "aurora: CPU use (top 8 instances), %",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, max by (cell, instance) (aws_rds_cpuutilization_average{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"}))",
          "legendFormat": "{{cell}} {{instance}}"
