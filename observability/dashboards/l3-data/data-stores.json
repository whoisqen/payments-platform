      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "title": "kafka: worst consumer lag",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "max(sum by (consumergroup, topic) (kafka_consumergroup_lag{env=~\"$env\",region=~\"$region\"}))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
