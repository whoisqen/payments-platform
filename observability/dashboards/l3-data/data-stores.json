              },
              {
                "color": "yellow",
                "value": 70.0
              },
              {
                "color": "red",
                "value": 85.0
              }
            ]
          },
          "min": 0,
          "max": 100,
          "decimals": 1,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "title": "memorydb: evicted keys, 15 min",
      "description": "Any eviction is a fault: the policy is noeviction.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(redis_evicted_keys_total{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"}[15m])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
