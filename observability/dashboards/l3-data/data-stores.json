        "h": 8
      },
      "title": "clickhouse: free disk, %",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * min by (cluster, instance) (ClickHouseAsyncMetrics_DiskAvailable_default{env=~\"$env\",region=~\"$region\"} / ClickHouseAsyncMetrics_DiskTotal_default{env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "{{cluster}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
