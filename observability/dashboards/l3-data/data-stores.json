    {
      "id": 8,
      "type": "row",
      "title": "Aurora",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "title": "aurora: connections, % of the limit (top 8)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, 100 * sum by (cell, instance) (pg_stat_database_numbackends{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"}) / (max by (cell, instance) (pg_settings_max_connections{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"}) > 0))",
          "legendFormat": "{{cell}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80.0
              }
            ]
          },
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "title": "aurora: replica lag by cell, ms",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cell) (aws_rds_aurora_replica_lag_maximum{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"})",
