          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "title": "aurora: top 10 queries by execution time, ms per second",
      "description": "From pg_stat_statements; queryid is a hash, not a statement text.",
      "targets": [
        {
          "refId": "A",
