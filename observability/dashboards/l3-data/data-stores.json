        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "ClickHouse, Kafka, DynamoDB, OpenSearch",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      },
      "panels": []
