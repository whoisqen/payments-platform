{
  "uid": "data-stores",
  "title": "L3 Data stores",
  "description": "Aurora, MemoryDB, ClickHouse, Kafka, DynamoDB and OpenSearch: where exactly is the bottleneck in the data tier?",
  "tags": [
    "payments-platform",
    "l3",
    "data"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "liveNow": false,
  "weekStart": "",
  "fiscalYearStartMonth": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "text": "default",
          "value": "default"
        }
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up, env)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "hide": 0
      },
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{env=~\"$env\"}, region)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "eu-central-1",
          "value": "eu-central-1"
        },
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "cell",
        "label": "Cell",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{env=~\"$env\",region=~\"$region\"}, cell)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{env=~\"$env\"}, service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 2,
        "allValue": ".*"
      },
      {
        "name": "psp",
        "label": "PSP",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(psp_requests_total{env=~\"$env\",region=~\"$region\"}, psp)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 2,
        "allValue": ".*"
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "L0 Platform overview",
      "url": "/d/platform-overview",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "type": "link",
      "title": "L2 Cells",
      "url": "/d/cells",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "type": "link",
      "title": "L3 Backup and restore",
      "url": "/d/backup",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "type": "dashboards",
      "title": "All dashboards",
      "tags": [
        "payments-platform"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Runbooks: data",
      "url": "https://github.com/whoisqen/payments-platform/tree/main/docs/runbooks/data",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(argocd_app_info{env=~\"$env\"}[1m]) > 0",
        "titleFormat": "deploy {{name}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "title": "aurora: worst connection use",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "max(100 * sum by (cell, instance) (pg_stat_database_numbackends{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"}) / (max by (cell, instance) (pg_settings_max_connections{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"}) > 0))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80.0
              }
            ]
          },
          "min": 0,
          "max": 100,
          "decimals": 1,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "title": "aurora: worst replica lag",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "max(aws_rds_aurora_replica_lag_maximum{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              }
            ]
          },
          "min": 0,
          "decimals": 0,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "title": "memorydb: worst memory use",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "max(100 * max by (cell, instance) (redis_memory_used_bytes{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"} / redis_memory_max_bytes{env=~\"$env\",region=~\"$region\",cell=~\"$cell\"}))",
          "legendFormat": "",
          "instant": true,
          "range": false
