      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "title": "opensearch: domains in red",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (domain_name) (aws_es_cluster_statusred_maximum{env=~\"$env\",region=~\"$region\"}) >= 1) or vector(0)",
          "legendFormat": "",
