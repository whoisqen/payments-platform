      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "title": "clickhouse: replication delay, s",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cluster) (ClickHouseAsyncMetrics_ReplicasMaxAbsoluteDelay{env=~\"$env\",region=~\"$region\"})",
