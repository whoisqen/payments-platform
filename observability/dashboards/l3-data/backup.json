{
  "uid": "backup",
  "title": "L3 Backup and restore",
  "description": "Can we restore, how fast, and how old is the newest recovery point?",
  "tags": [
    "payments-platform",
    "l3",
    "backup",
    "dr"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5m",
  "liveNow": false,
  "weekStart": "",
  "fiscalYearStartMonth": 0,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "text": "default",
          "value": "default"
        }
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up, env)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "hide": 0
      },
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{env=~\"$env\"}, region)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "eu-central-1",
          "value": "eu-central-1"
        },
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "cell",
        "label": "Cell",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{env=~\"$env\",region=~\"$region\"}, cell)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 2,
        "allValue": ".*"
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{env=~\"$env\"}, service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 2,
        "allValue": ".*"
      },
      {
        "name": "psp",
        "label": "PSP",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(psp_requests_total{env=~\"$env\",region=~\"$region\"}, psp)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 2,
        "allValue": ".*"
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "L0 Platform overview",
      "url": "/d/platform-overview",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "type": "link",
      "title": "L3 Data stores",
      "url": "/d/data-stores",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "type": "link",
      "title": "L3 DR switch readiness",
      "url": "/d/dr-switch",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "type": "dashboards",
      "title": "All dashboards",
      "tags": [
        "payments-platform"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Runbooks: backup-dr",
      "url": "https://github.com/whoisqen/payments-platform/tree/main/docs/runbooks/backup-dr",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "increase(argocd_app_sync_total{env=~\"$env\",phase=\"Succeeded\"}[2m]) > 0",
        "titleFormat": "deploy {{name}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Recovery points",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "title": "backup: failed jobs, 24 h",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(aws_backup_number_of_backup_jobs_failed_sum{env=~\"$env\",region=~\"$region\"}[1d])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "min": 0,
          "decimals": 0,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "title": "restore test: stores failing",
      "description": "Stores whose last daily restore failed its data check.",
      "targets": [
        {
          "refId": "A",
          "expr": "count(restore_test_success{env=~\"$env\",region=~\"$region\"} == 0) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "min": 0,
          "decimals": 0,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "title": "PITR: worst restorable time lag",
      "description": "Data loss on a point-in-time restore is at most 5 minutes (D2).",
      "targets": [
        {
          "refId": "A",
          "expr": "max(database_latest_restorable_time_lag_seconds{env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 150.0
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "min": 0,
          "decimals": 2,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "title": "backup: age of the last successful backup by store, s",
      "description": "BackupMissing pages when the age exceeds twice the backup interval of the store.",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (store) (backup_last_success_timestamp_seconds{env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "{{store}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "namePlacement": "left",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Restore speed",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "title": "restore: duration against its target by store, s",
      "description": "Alerts fire at 80% of the target; the Aurora target is 30 minutes (D4).",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (store) (backup_restore_duration_seconds{env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "{{store}} duration"
        },
        {
          "refId": "B",
          "expr": "max by (store) (backup_restore_target_seconds{env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "{{store}} target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "title": "restore: duration, % of the target by store",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max by (store) (backup_restore_duration_seconds{env=~\"$env\",region=~\"$region\"}) / (max by (store) (backup_restore_target_seconds{env=~\"$env\",region=~\"$region\"}) > 0)",
          "legendFormat": "{{store}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80.0
              }
            ]
          },
          "min": 0,
          "max": 150,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 9
      },
      "title": "restore: duration against the data size",
      "description": "Duration on the left axis, data size on the right: the restore time against data growth.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (store) (backup_restore_duration_seconds{env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "{{store}} duration"
        },
        {
          "refId": "B",
          "expr": "max by (store) (backup_source_size_bytes{env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "{{store}} size"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* size"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 9
      },
      "title": "restore test: last result by store",
      "description": "Result of the last daily restore and its data check.",
      "targets": [
        {
          "refId": "A",
          "expr": "min by (store) (restore_test_success{env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "failed",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "passed",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "cellOptions": {
              "type": "color-background"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Result",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Result"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Copies",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 9
      },
      "title": "snapshot copies: age of the last copy by region, s",
      "description": "SnapshotCopyStale warns above 2 hours.",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, time() - max by (store, region) (snapshot_copy_last_success_timestamp_seconds{env=~\"$env\",region=~\"$region\"}))",
          "legendFormat": "{{store}} {{region}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 7200
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 9
      },
      "title": "backup: copy job failures per 24 h by vault",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backup_vault) (increase(aws_backup_number_of_copy_jobs_failed_sum{env=~\"$env\",region=~\"$region\"}[1d]))",
          "legendFormat": "{{backup_vault}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
