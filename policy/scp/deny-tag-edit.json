{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyEditingProtectedTagsExceptAutomation",
      "Effect": "Deny",
      "Action": [
        "tag:TagResources",
        "tag:UntagResources",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "rds:AddTagsToResource",
        "rds:RemoveTagsFromResource",
        "s3:PutBucketTagging",
        "s3:DeleteBucketTagging",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "kms:TagResource",
        "kms:UntagResource",
        "memorydb:TagResource",
        "memorydb:UntagResource"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "pci-scope",
            "backup-tier",
            "data-class",
            "managed-by"
          ]
        },
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/terraform-apply",
            "arn:aws:iam::*:role/atlantis"
          ]
        }
      }
    }
  ]
}
