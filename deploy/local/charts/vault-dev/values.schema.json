{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "environment", "cells", "kvMount", "materialSecret", "externalSecrets", "resources"],
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vault", "node"],
      "properties": {
        "vault": { "type": "string", "pattern": "@sha256:[a-f0-9]{64}$" },
        "node": { "type": "string", "pattern": "@sha256:[a-f0-9]{64}$" }
      }
    },
    "environment": { "enum": ["dev", "stage", "prod"] },
    "cells": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(cell-[0-3]|spare)$" } },
    "kvMount": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "materialSecret": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "serviceAccount", "namespace", "audience"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "serviceAccount": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vault", "seed"],
      "properties": {
        "vault": { "type": "object" },
        "seed": { "type": "object" }
      }
    }
  }
}
