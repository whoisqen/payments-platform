{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "image",
    "redis",
    "rateLimit",
    "autoscaling",
    "resources"
  ],
  "properties": {
    "requireResolved": {
      "type": "boolean"
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "registry",
        "environment"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "Deployment"
        },
        "minReadySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "preStopSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grpc": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "http": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "metrics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 3
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 3
        },
        "targetCPU": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPU"
      ]
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+:[0-9]{2,5}$|^REPLACE_[A-Z_]+$"
        },
        "type": {
          "enum": [
            "single",
            "cluster"
          ]
        },
        "tls": {
          "type": "boolean"
        },
        "poolSize": {
          "type": "integer",
          "minimum": 1
        },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "store": {
              "type": "string",
              "minLength": 1
            },
            "refreshInterval": {
              "type": "string"
            },
            "property": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "egressCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9./]+$"
          }
        }
      },
      "required": [
        "endpoint",
        "type",
        "tls"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "edgeNamespace": {
          "type": "string",
          "minLength": 1
        },
        "edgePodLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "monitoringNamespace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "requestClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "payments",
              "read",
              "list"
            ]
          }
        },
        "shadowMode": {
          "type": "boolean"
        },
        "defaults": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit",
              "requestsPerUnit"
            ],
            "properties": {
              "unit": {
                "type": "string"
              },
              "requestsPerUnit": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "tiers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "requestsPerUnit"
              ],
              "properties": {
                "unit": {
                  "type": "string"
                },
                "requestsPerUnit": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "rateKeys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              },
              "tier": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "limits": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "unit": {
                      "type": "string"
                    },
                    "requestsPerUnit": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            },
            "required": [
              "name",
              "rateKeys"
            ]
          }
        }
      },
      "required": [
        "domain",
        "requestClasses",
        "defaults",
        "tiers",
        "overrides"
      ]
    },
    "platform-common": {
      "type": "object"
    },
    "istio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "peerAuthentication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "authorizationPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "gatewayPrincipal": {
              "type": "string",
              "pattern": "^cluster\\.local/ns/[^/]+/sa/[^/]+$"
            }
          }
        }
      }
    }
  }
}
