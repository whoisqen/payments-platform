# Vault policy of the read-only groups: health, mounts, policies, auth methods and identities; no secret.
# Generated by tools/config/render/render_admin_sso.py; edit the generator, not this file.
path "sys/health" {
  capabilities = ["read"]
}
path "sys/seal-status" {
  capabilities = ["read"]
}
path "sys/mounts" {
  capabilities = ["read"]
}
path "sys/auth" {
  capabilities = ["read"]
}
path "sys/audit" {
  capabilities = ["read", "sudo"]
}
path "sys/policies/acl" {
  capabilities = ["list"]
}
path "sys/policies/acl/*" {
  capabilities = ["read"]
}
path "identity/group/*" {
  capabilities = ["read", "list"]
}
path "secret/*" {
  capabilities = ["deny"]
}
