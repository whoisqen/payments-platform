# Vault policy of the administrators of the identity provider group: manages Vault itself, reads no secret.
# Generated by tools/config/render/render_admin_sso.py; edit the generator, not this file.
path "sys/*" {
  capabilities = ["create", "read", "update", "delete", "list", "sudo"]
}
path "auth/*" {
  capabilities = ["create", "read", "update", "delete", "list", "sudo"]
}
path "identity/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}
# No administrator reads or changes the stored secrets; sys/raw would bypass this
path "secret/data/*" {
  capabilities = ["deny"]
}
path "secret/delete/*" {
  capabilities = ["deny"]
}
path "secret/undelete/*" {
  capabilities = ["deny"]
}
path "secret/destroy/*" {
  capabilities = ["deny"]
}
path "sys/raw/*" {
  capabilities = ["deny"]
}
