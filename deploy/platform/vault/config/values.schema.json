{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requireResolved": {
      "type": "boolean"
    },
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceName": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "clusterPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "pattern": "^\\S+( \\S+){4}$"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^(REPLACE_[A-Z0-9_]+|[a-z0-9.:/_-]+)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "authMount": {
          "type": "string",
          "minLength": 1
        },
        "authRole": {
          "type": "string",
          "minLength": 1
        },
        "bucket": {
          "type": "string",
          "pattern": "^(REPLACE_[A-Z0-9_]+|[a-z0-9][a-z0-9.-]{2,62})$"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "region": {
          "type": "string",
          "pattern": "^(REPLACE_[A-Z0-9_]+|[a-z]{2}-[a-z]+-[0-9])$"
        },
        "kmsKeyId": {
          "type": "string",
          "pattern": "^(|REPLACE_[A-Z0-9_]+|[0-9a-f-]{36}|arn:aws:kms:[a-z0-9-]+:[0-9]{12}:key/[0-9a-f-]{36}|alias/[A-Za-z0-9/_-]+)$"
        },
        "roleArn": {
          "type": "string",
          "pattern": "^(|REPLACE_[A-Z0-9_]+|arn:aws:iam::[0-9]{12}:role/.+)$"
        },
        "serviceAccountName": {
          "type": "string",
          "minLength": 1
        },
        "scratchSizeLimit": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3300
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clientNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "apiServerCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f.:]+/[0-9]{1,3}$"
          }
        },
        "awsEndpointCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f.:]+/[0-9]{1,3}$"
          }
        },
        "clientCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f.:]+/[0-9]{1,3}$"
          }
        }
      }
    },
    "vault-snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^(|sha256:[a-f0-9]{64})$"
            }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceAccountName": {
          "type": "string",
          "minLength": 1
        },
        "roleArn": {
          "type": "string",
          "pattern": "^(|REPLACE_[A-Z0-9_]+|arn:aws:iam::[0-9]{12}:role/.+)$"
        },
        "region": {
          "type": "string",
          "pattern": "^(REPLACE_[A-Z0-9_]+|[a-z]{2}-[a-z]+-[0-9])$"
        },
        "initSecretId": {
          "type": "string",
          "pattern": "^(REPLACE_[A-Z0-9_]+|[A-Za-z0-9/_+=.@-]+)$"
        },
        "initAddress": {
          "type": "string",
          "pattern": "^https?://.+"
        },
        "recoveryShares": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "recoveryThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "kvMount": {
          "type": "string",
          "minLength": 1
        },
        "kvMaxVersions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "snapshotPolicy": {
          "type": "string",
          "minLength": 1
        },
        "externalSecrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "authRole": {
              "type": "string",
              "minLength": 1
            },
            "serviceAccountName": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "autopilot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cleanupDeadServers": {
              "type": "boolean"
            },
            "deadServerLastContactThreshold": {
              "type": "string",
              "pattern": "^[0-9]+(s|m|h)$"
            },
            "minQuorum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "serverStabilizationTime": {
              "type": "string",
              "pattern": "^[0-9]+(s|m|h)$"
            }
          }
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3300
        },
        "resources": {
          "type": "object"
        }
      }
    }
  }
}
