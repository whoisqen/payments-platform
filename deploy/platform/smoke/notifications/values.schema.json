{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["namePrefix", "environments", "dispatchCell", "secret"],
  "properties": {
    "namePrefix": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["dev", "stage"]}
    },
    "dispatchCell": {"type": "string", "pattern": "^(cell-[0-9]+|spare)$"},
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "refreshInterval", "secretStore", "remoteKey"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "refreshInterval": {"type": "string"},
        "secretStore": {"type": "string", "minLength": 1},
        "remoteKey": {"type": "string", "pattern": "^shared-services/[a-z0-9/-]+$"}
      }
    }
  }
}
