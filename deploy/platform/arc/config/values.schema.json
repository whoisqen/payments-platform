{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "secretStore",
    "refreshInterval",
    "systemsQuotaPods",
    "scaleSets",
    "defaultRequests",
    "networkPolicy"
  ],
  "properties": {
    "refreshInterval": {
      "type": "string"
    },
    "secretStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scaleSets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/scaleSet"
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dnsNamespace",
        "cdeCidrs",
        "cellCidrs",
        "prDeniedCidrs",
        "prDeniedCidrsV6"
      ],
      "properties": {
        "dnsNamespace": {
          "type": "string"
        },
        "cdeCidrs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cellCidrs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "prDeniedCidrs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "prDeniedCidrsV6": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "systemsQuotaPods": {
      "type": "integer",
      "minimum": 1
    },
    "defaultRequests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "scaleSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "githubAppKey",
        "quota"
      ],
      "properties": {
        "githubAppKey": {
          "type": "string",
          "minLength": 1
        },
        "roleArn": {
          "type": "string",
          "pattern": "^arn:aws:iam::"
        },
        "privileged": {
          "type": "boolean"
        },
        "untrusted": {
          "type": "boolean"
        },
        "quota": {
          "$ref": "#/definitions/quota"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "untrusted": {
                "const": true
              }
            },
            "required": [
              "untrusted"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "roleArn"
                  ]
                },
                {
                  "required": [
                    "privileged"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "roleArn"
            ]
          }
        }
      ]
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pods",
        "cpu",
        "memory",
        "ephemeralStorage"
      ],
      "properties": {
        "pods": {
          "type": "integer",
          "minimum": 1
        },
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        },
        "ephemeralStorage": {
          "type": "string"
        }
      }
    }
  }
}
