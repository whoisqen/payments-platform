{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "secretStore",
    "refreshInterval",
    "systemsQuotaPods",
    "scaleSets",
    "networkPolicy"
  ],
  "properties": {
    "refreshInterval": {
      "type": "string"
    },
    "secretStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scaleSets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ci-prod",
        "ci-stage",
        "ci-pr"
      ],
      "properties": {
        "ci-prod": {
          "$ref": "#/definitions/privileged"
        },
        "ci-stage": {
          "$ref": "#/definitions/privileged"
        },
        "ci-pr": {
          "$ref": "#/definitions/unprivileged"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dnsNamespace",
        "cdeCidrs",
        "cellCidrs",
        "prDeniedCidrs",
        "prDeniedCidrsV6"
      ],
      "properties": {
        "dnsNamespace": {
          "type": "string"
        },
        "cdeCidrs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cellCidrs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "prDeniedCidrs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "prDeniedCidrsV6": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "systemsQuotaPods": {
      "type": "integer",
      "minimum": 1
    }
  },
  "definitions": {
    "priorityClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "preemptionPolicy"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "maximum": 1000000
        },
        "preemptionPolicy": {
          "enum": [
            "PreemptLowerPriority",
            "Never"
          ]
        }
      }
    },
    "privileged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "githubAppKey",
        "priorityClass",
        "roleArn",
        "quota"
      ],
      "properties": {
        "priorityClass": {
          "$ref": "#/definitions/priorityClass"
        },
        "roleArn": {
          "type": "string",
          "pattern": "^arn:aws:iam::"
        },
        "githubAppKey": {
          "type": "string",
          "minLength": 1
        },
        "quota": {
          "$ref": "#/definitions/quota"
        }
      }
    },
    "unprivileged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "githubAppKey",
        "priorityClass",
        "quota"
      ],
      "properties": {
        "priorityClass": {
          "$ref": "#/definitions/priorityClass"
        },
        "githubAppKey": {
          "type": "string",
          "minLength": 1
        },
        "quota": {
          "$ref": "#/definitions/quota"
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pods",
        "cpu",
        "memory",
        "ephemeralStorage"
      ],
      "properties": {
        "pods": {
          "type": "integer",
          "minimum": 1
        },
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        },
        "ephemeralStorage": {
          "type": "string"
        }
      }
    }
  }
}
