{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["secretStore", "refreshInterval", "scaleSets", "networkPolicy"],
  "properties": {
    "refreshInterval": {"type": "string"},
    "secretStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "githubAppKey"],
      "properties": {"name": {"type": "string", "minLength": 1}, "githubAppKey": {"type": "string", "minLength": 1}}
    },
    "scaleSets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci-prod", "ci-stage", "ci-pr"],
      "properties": {
        "ci-prod": {"$ref": "#/definitions/privileged"},
        "ci-stage": {"$ref": "#/definitions/privileged"},
        "ci-pr": {"$ref": "#/definitions/unprivileged"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dnsNamespace", "deniedCidrs"],
      "properties": {
        "dnsNamespace": {"type": "string"},
        "deniedCidrs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  },
  "definitions": {
    "priorityClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "preemptionPolicy"],
      "properties": {
        "name": {"type": "string"},
        "value": {"type": "integer", "maximum": 1000000},
        "preemptionPolicy": {"enum": ["PreemptLowerPriority", "Never"]}
      }
    },
    "privileged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priorityClass", "roleArn"],
      "properties": {
        "priorityClass": {"$ref": "#/definitions/priorityClass"},
        "roleArn": {"type": "string", "pattern": "^arn:aws:iam::"}
      }
    },
    "unprivileged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priorityClass"],
      "properties": {"priorityClass": {"$ref": "#/definitions/priorityClass"}}
    }
  }
}
