{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["gatewaySelector", "port", "allowedPrincipals", "callers", "allowedPorts", "dnsLookupFamily"],
  "properties": {
    "gatewaySelector": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "allowedPrincipals": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9.-]+/ns/[a-z0-9-]+/sa/[a-z0-9-]+$"}},
    "callers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "podLabels"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "podLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
      }
    },
    "allowedPorts": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
    "dnsLookupFamily": {"enum": ["V4_ONLY", "V6_ONLY", "AUTO", "V4_PREFERRED", "ALL"]}
  }
}
