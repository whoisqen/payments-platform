{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["global"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["environment", "region", "dataCidrs", "endpointCidrs", "registry"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "workingHours": { "type": "object", "description": "Working window of dev and stage: workloads hold their floor inside it and scale to zero outside it (KEDA cron).", "required": ["timezone", "start", "end"], "additionalProperties": false, "properties": { "timezone": { "type": "string", "minLength": 1 }, "start": { "type": "string", "pattern": "^\\S+ \\S+ \\S+ \\S+ \\S+$" }, "end": { "type": "string", "pattern": "^\\S+ \\S+ \\S+ \\S+ \\S+$" } } },
        "environment": { "enum": ["dev", "stage", "prod"] },
        "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$" },
        "dataCidrs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$" }, "minItems": 1 },
        "endpointCidrs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$" }, "minItems": 1 }
      }
    },
    "locker": { "type": "object" },
    "locker-migrations": { "type": "object" }
  }
}
