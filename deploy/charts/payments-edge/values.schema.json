{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "gateway", "certificate", "routing", "rateLimit"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["environment", "region"],
      "properties": {
        "environment": { "enum": ["dev", "stage", "prod"] },
        "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$" }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "hosts", "tlsCredentialName"],
      "properties": {
        "selector": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
        "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "tlsCredentialName": { "type": "string", "minLength": 1 }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuerName", "issuerKind", "duration", "renewBefore"],
      "properties": {
        "issuerName": { "type": "string", "minLength": 1 },
        "issuerKind": { "enum": ["Issuer", "ClusterIssuer"] },
        "duration": { "type": "string", "pattern": "^[0-9]+h$" },
        "renewBefore": { "type": "string", "pattern": "^[0-9]+h$" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cellHeader", "timeout", "cells"],
      "properties": {
        "cellHeader": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "timeout": { "type": "string", "pattern": "^[0-9]+s$" },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "host"],
            "properties": {
              "name": { "type": "string", "pattern": "^(cell-[0-3]|spare)$" },
              "host": { "type": "string", "minLength": 1 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTokens", "tokensPerFill", "fillInterval"],
      "properties": {
        "maxTokens": { "type": "integer", "minimum": 1 },
        "tokensPerFill": { "type": "integer", "minimum": 1 },
        "fillInterval": { "type": "string", "pattern": "^[0-9]+s$" }
      }
    }
  }
}
