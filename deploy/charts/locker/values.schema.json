{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ]
    },
    "workload": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Deployment",
            "Rollout"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "syncWave": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "minReadySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "progressDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "strategy": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "RollingUpdate",
                "Recreate",
                "Canary"
              ]
            },
            "maxSurge": {
              "type": [
                "integer",
                "string"
              ]
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            },
            "weights": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "pauseDuration": {
              "type": "string",
              "pattern": "^[0-9]+[smh]$"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        "analysis": {
          "type": "object",
          "properties": {
            "prometheusAddress": {
              "type": "string",
              "pattern": "^https?://"
            },
            "maxErrorRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxP99DeltaMs": {
              "type": "number",
              "minimum": 0
            },
            "authorizationRate": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "prometheusAddress",
            "maxErrorRate",
            "maxP99DeltaMs"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "strategy"
      ]
    },
    "container": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "not": {
              "pattern": "^(LOCKER__|PGSSL|PGPASSWORD)"
            }
          }
        },
        "envFromSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "memory"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ]
        },
        "extraPorts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,14}$",
                "not": {
                  "const": "http"
                }
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "required": [
              "name",
              "port"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "port",
        "resources"
      ]
    },
    "probes": {
      "type": "object",
      "properties": {
        "startup": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "path"
          ]
        },
        "liveness": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "path"
          ]
        },
        "readiness": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "path"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "startup",
        "liveness",
        "readiness"
      ]
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "preStopSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 30
        }
      },
      "additionalProperties": false
    },
    "scheduling": {
      "type": "object",
      "properties": {
        "nodePool": {
          "enum": [
            "system",
            "payments",
            "workers"
          ]
        },
        "tolerations": {
          "type": "array"
        }
      },
      "additionalProperties": false,
      "required": [
        "nodePool"
      ]
    },
    "warmup": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minRatio": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1
        },
        "maxWaitSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "maxPendingRequests": {
          "type": "integer",
          "minimum": 1
        },
        "extraPorts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,14}$",
                "not": {
                  "const": "http"
                }
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "required": [
              "name",
              "port"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "hpa",
            "keda"
          ]
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 3
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 3
        },
        "targetCPU": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "rpsPerPod": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pollingInterval": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownPeriod": {
          "type": "integer",
          "minimum": 0
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "kind",
              "minReplicas",
              "maxReplicas"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "keda"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "triggers"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hpa"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "targetCPU"
            ]
          }
        }
      ]
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dataPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "extraIngress": {
          "type": "array"
        },
        "extraEgress": {
          "type": "array"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "interval": {
          "type": "string",
          "pattern": "^[0-9]+[smh]$"
        },
        "port": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,14}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "create"
      ]
    },
    "istio": {
      "type": "object",
      "properties": {
        "inject": {
          "type": "boolean"
        },
        "authorizationPolicy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "principals": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "enabled"
          ]
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object"
    },
    "platform-common": {
      "type": "object"
    },
    "securityGroupPolicy": {
      "type": "object",
      "properties": {
        "securityGroupIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(sg-[0-9a-f]+|REPLACE_LOCKER_POD_SG_ID)$"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "securityGroupIds"
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "log": {
          "type": "object",
          "properties": {
            "console": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "level": {
                  "enum": [
                    "TRACE",
                    "DEBUG",
                    "INFO",
                    "WARN",
                    "ERROR"
                  ]
                },
                "log_format": {
                  "enum": [
                    "json",
                    "default"
                  ]
                },
                "filtering_directive": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "enabled",
                "level",
                "log_format"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "console"
          ]
        },
        "server": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "host"
          ]
        },
        "limit": {
          "type": "object",
          "properties": {
            "request_count": {
              "type": "integer",
              "minimum": 1
            },
            "duration": {
              "type": "integer",
              "minimum": 1
            },
            "buffer_size": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "request_count",
            "duration"
          ]
        },
        "cache": {
          "type": "object",
          "properties": {
            "tti": {
              "type": "integer",
              "minimum": 1
            },
            "max_capacity": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "max_capacity"
          ]
        },
        "database": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "dbname": {
              "type": "string",
              "minLength": 1
            },
            "pool_size": {
              "type": "integer",
              "minimum": 1
            },
            "min_idle": {
              "type": "integer",
              "minimum": 0
            },
            "max_lifetime": {
              "type": "integer",
              "minimum": 1
            },
            "idle_timeout": {
              "type": "integer",
              "minimum": 1
            },
            "connection_timeout": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "username",
            "host",
            "port",
            "dbname"
          ]
        },
        "secrets_management": {
          "type": "object",
          "properties": {
            "secrets_manager": {
              "const": "aws_kms"
            },
            "aws_kms": {
              "type": "object",
              "properties": {
                "key_id": {
                  "type": "string",
                  "pattern": "^(alias/[A-Za-z0-9/_-]+|REPLACE_[A-Z_]+)$"
                },
                "region": {
                  "type": "string",
                  "pattern": "^([a-z]{2}-[a-z]+-[0-9]|REPLACE_[A-Z_]+)$"
                }
              },
              "additionalProperties": false,
              "required": [
                "key_id",
                "region"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "secrets_manager",
            "aws_kms"
          ]
        },
        "metrics": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "disabled",
                "otlp",
                "prometheus"
              ]
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            },
            "endpoint_timeout_secs": {
              "type": "integer",
              "minimum": 1
            },
            "metrics_export_interval_secs": {
              "type": "integer",
              "minimum": 1
            },
            "background_metrics_collection_interval_secs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "api_client": {
          "type": "object",
          "properties": {
            "client_idle_timeout": {
              "type": "integer",
              "minimum": 1
            },
            "pool_max_idle_per_host": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": []
        },
        "external_key_manager": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "disabled",
                "enabled",
                "enabled_with_mtls"
              ]
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "additionalProperties": false,
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "enabled",
                  "enabled_with_mtls"
                ]
              }
            }
          },
          "then": {
            "required": [
              "mode",
              "url"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "log",
        "server",
        "limit",
        "cache",
        "database",
        "secrets_management",
        "metrics",
        "api_client",
        "external_key_manager"
      ],
      "description": "Non-secret settings only; secret keys (password, master_key, public_key, locker_private_key, identity, ca_cert) are rejected"
    },
    "postgresTls": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "verify-full"
        },
        "rootCert": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "rootCert"
      ]
    },
    "tenants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "schema": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$"
          },
          "redisKeyPrefix": {
            "type": "string",
            "pattern": "^[^{}]+$"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "schema",
          "redisKeyPrefix"
        ]
      }
    },
    "externalSecret": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "storeName": {
          "const": "vault"
        },
        "pathPrefix": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/-]*[a-z0-9]$"
        },
        "refreshInterval": {
          "type": "string",
          "pattern": "^[0-9]+[smh]$"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "storeName",
        "pathPrefix",
        "refreshInterval"
      ]
    },
    "podIdentityAgentCidr": {
      "const": "169.254.170.23/32"
    }
  },
  "additionalProperties": false,
  "required": [
    "image",
    "workload",
    "container",
    "probes",
    "scheduling",
    "service",
    "autoscaling",
    "pdb",
    "networkPolicy",
    "serviceAccount",
    "securityGroupPolicy",
    "config",
    "postgresTls",
    "tenants",
    "externalSecret",
    "podIdentityAgentCidr"
  ]
}
