{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "repo",
    "cluster",
    "observability"
  ],
  "properties": {
    "repo": {
      "type": "object",
      "required": [
        "url",
        "revision"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://[^/]+/[^/]+/[^/]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cluster": {
      "type": "object",
      "required": [
        "namePrefix",
        "region"
      ],
      "properties": {
        "namePrefix": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$"
        }
      }
    },
    "observability": {
      "type": "object",
      "required": [
        "grafanaUrl"
      ],
      "properties": {
        "grafanaUrl": {
          "type": "string",
          "pattern": "^https://[^/]+$"
        }
      }
    },
    "gatedEnvironments": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(prod|cde-prod)$"
      },
      "uniqueItems": true
    },
    "gated": {
      "type": "object",
      "required": [
        "revision"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?)?$"
        }
      },
      "additionalProperties": false
    }
  }
}
