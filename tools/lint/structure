#!/usr/bin/env python3
"""Fail when a directory holds more than LIMIT files (README.md excluded); vendor/ and .claude/ are exempt."""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts" / "claude-hooks"))
from _common import ROOT  # noqa: E402

LIMIT = 10
SKIP = {".git", ".terraform", "node_modules", "__pycache__", "vendor", ".claude"}
bad = []
for d, dirs, files in os.walk(ROOT):
    dirs[:] = [x for x in dirs if x not in SKIP]
    n = len([f for f in files if f != "README.md"])
    if n > LIMIT:
        bad.append((Path(d).relative_to(ROOT).as_posix() or ".", n))
for d, n in bad:
    print(f"structure: error: {d} holds {n} files (limit {LIMIT}); split it by concern")
print(f"structure: {len(bad)} error(s)")
sys.exit(1 if bad else 0)
