#!/bin/bash
# Boot of a CI runner instance: install, register with GitHub as a service, protect itself while a job runs. Everything here is replaced with the instance.
set -euo pipefail
exec > >(tee /var/log/runner-bootstrap.log) 2>&1

dnf install -y docker git jq tar gzip libicu iptables-nft
systemctl enable --now docker

useradd --create-home --shell /bin/bash runner
usermod -aG docker runner

# Local NVMe, when the instance type has one, holds the work directory and the docker data: builds never wait for EBS.
store=$(ls /dev/disk/by-id/nvme-Amazon_EC2_NVMe_Instance_Storage_* 2>/dev/null | head -1 || true)
if [ -n "$store" ]; then
  mkfs.xfs -f "$store"
  mount "$store" /home/runner
  chown runner:runner /home/runner
fi

mkdir -p /opt/runner
cd /opt/runner
curl -fsSL -o runner.tgz "https://github.com/actions/runner/releases/download/v${runner_version}/actions-runner-linux-arm64-${runner_version}.tar.gz"
echo "${runner_sha256}  runner.tgz" | sha256sum -c -
tar xzf runner.tgz
rm runner.tgz
chown -R runner:runner /opt/runner

# Registration token of the repository through the GitHub App of this pool; the credentials are read once and not kept.
secret=$(aws secretsmanager get-secret-value --region "${region}" --secret-id "${secret_id}" --query SecretString --output text)
app_id=$(jq -r .app_id <<<"$secret")
installation_id=$(jq -r .installation_id <<<"$secret")
key=$(jq -r .private_key <<<"$secret")
b64() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
now=$(date +%s)
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64)
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$app_id" | b64)
signature=$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign <(printf '%s' "$key") | b64)
installation_token=$(curl -fsS -X POST -H "Authorization: Bearer $header.$payload.$signature" -H "Accept: application/vnd.github+json" \
  "https://api.github.com/app/installations/$installation_id/access_tokens" | jq -r .token)
registration_token=$(curl -fsS -X POST -H "Authorization: Bearer $installation_token" -H "Accept: application/vnd.github+json" \
  "https://api.github.com/repos/${github_repository}/actions/runners/registration-token" | jq -r .token)
unset secret app_id installation_id key header payload signature installation_token

sudo -u runner ./config.sh --unattended --replace --url "https://github.com/${github_repository}" --token "$registration_token" \
  --name "$(hostname)" --labels "${labels}" --work /home/runner/_work
unset registration_token
./svc.sh install runner
./svc.sh start

# An instance that runs a job must not be removed by a scale-in: a root service sets the protection while the job process exists.
cat >/usr/local/bin/protect-while-busy <<'PROTECT'
#!/bin/bash
token=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')
id=$(curl -fsS -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id)
state=off
while true; do
  if pgrep -f Runner.Worker >/dev/null; then want=on; else want=off; fi
  if [ "$want" != "$state" ]; then
    if [ "$want" = on ]; then flag=--protected-from-scale-in; else flag=--no-protected-from-scale-in; fi
    if aws autoscaling set-instance-protection --region "${region}" --auto-scaling-group-name "${asg_name}" --instance-ids "$id" "$flag"; then state=$want; fi
  fi
  sleep 10
done
PROTECT
chmod +x /usr/local/bin/protect-while-busy
cat >/etc/systemd/system/protect-while-busy.service <<'UNIT'
[Unit]
Description=Protect the instance from scale-in while a job runs
After=network-online.target

[Service]
ExecStart=/usr/local/bin/protect-while-busy
Restart=always

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now protect-while-busy
%{ if block_metadata ~}

# Pull request code runs as the runner user and must not read the credentials of the instance role (containers are stopped by the hop limit of 1).
iptables -I OUTPUT -m owner --uid-owner runner -d 169.254.169.254 -j REJECT
%{ endif ~}
