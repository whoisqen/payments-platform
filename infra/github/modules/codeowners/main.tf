locals {
  teams = { for k, v in var.teams : k => "${var.organization}/${v}" }

  owners = yamldecode(file("${var.owners_file}")).rules

  codeowners = join("\n", concat(
    ["# Generated by infra/github from owners.yaml; do not edit by hand."],
    [for r in local.owners : "${r.path} ${join(" ", distinct([for t in r.teams : lookup(var.handles, t, "@${local.teams[t]}")]))}"],
    [""],
  ))
}

resource "github_repository_file" "codeowners" {
  repository          = var.repository
  branch              = var.branch
  file                = "CODEOWNERS"
  content             = local.codeowners
  commit_message      = var.commit.message
  commit_author       = var.commit.author
  commit_email        = var.commit.email
  overwrite_on_create = true
}
