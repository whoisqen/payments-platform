{
  "mcpServers": {
    "aws-docs": {
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server==1.2.6"
      ]
    },
    "aws-api": {
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server==1.6.1"
      ],
      "env": {
        "AWS_PROFILE": "claude-agent-read-${CLAUDE_ENV:-dev}",
        "READ_OPERATIONS_ONLY": "true"
      }
    },
    "aws-cost": {
      "command": "uvx",
      "args": [
        "awslabs.cost-explorer-mcp-server==0.0.21"
      ],
      "env": {
        "AWS_PROFILE": "claude-agent-read-${CLAUDE_ENV:-dev}"
      }
    },
    "terraform-registry": {
      "command": "npx",
      "args": [
        "-y",
        "terraform-mcp-server@0.13.0"
      ]
    },
    "kubernetes": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-kubernetes@4.2.3"
      ],
      "env": {
        "ALLOW_ONLY_NON_DESTRUCTIVE_TOOLS": "true",
        "KUBECONFIG": "${KUBECONFIG_CLAUDE_READ}"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}",
        "X-MCP-Readonly": "true"
      }
    },
    "github-write": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_WRITE_TOKEN}"
      }
    },
    "obs-gateway": {
      "type": "http",
      "url": "${OBS_GATEWAY_URL}",
      "headers": {
        "Authorization": "Bearer ${OBS_GATEWAY_TOKEN}"
      }
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "pagerduty": {
      "command": "uvx",
      "args": [
        "pagerduty-mcp==1.1.0"
      ],
      "env": {
        "PAGERDUTY_USER_API_KEY": "${PAGERDUTY_API_KEY}"
      }
    }
  }
}
